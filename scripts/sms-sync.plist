<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edenlabs.sms-sync</string>

  <!-- Every 15 minutes. A bank SMS arrives seconds after the transaction, so
       this is about keeping the dashboard current rather than instant. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <!-- A DEDICATED COPY OF NODE, not /usr/local/bin/node.

       launchd runs this with no parent application, so Terminal's Full Disk
       Access does not apply and the job needs its own grant. Granting it to
       /usr/local/bin/node would give Messages access to every node script on
       the machine; granting it to a copy used only by this job does not.

       Create it with:
         mkdir -p ~/.edenlabs/bin && cp "$(which node)" ~/.edenlabs/bin/edenlabs-node
       then add that file to Full Disk Access (⌘⇧G in the file picker). -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/charlesrohan/.edenlabs/bin/edenlabs-node</string>
    <string>/Users/charlesrohan/Projects/EdenLabs Dashboard/eden-labs/scripts/sms-sync.mjs</string>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/edenlabs-sms-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/edenlabs-sms-sync.log</string>
</dict>
</plist>
