# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real secrets.

# Password guarding destructive actions (ending a contract).
# Client-side only — replaced by Supabase auth in step 3/4.
VITE_OWNER_PASSCODE=eden-labs

# Buffer personal API key (buffer.com -> Settings -> API).
# No VITE_ prefix on purpose: this must stay server-side. It's read by
# vite.config.js in dev and by api/buffer.js in production (Vercel) — the
# browser only ever calls same-origin /api/buffer, never api.buffer.com
# directly. See vite.config.js for why.
BUFFER_API_KEY=

# Fathom personal API key (developers.fathom.ai -> generated via the website's
# settings area). Same server-side-only rule as Buffer — read by api/fathom.js.
FATHOM_API_KEY=

# Resend — sending invoices by email (resend.com, free tier: 100/day).
RESEND_API_KEY=
# Leave unset to send from Resend's shared onboarding@resend.dev address until
# you verify your own domain. Once verified: Eden Labs <you@yourdomain.com>
RESEND_FROM=

# Google Calendar secret address, in iCal format (Calendar -> Settings ->
# your calendar -> "Secret address in iCal format"). Treat like a password.
GOOGLE_CALENDAR_ICAL_URL=
