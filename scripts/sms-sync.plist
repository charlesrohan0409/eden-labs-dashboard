<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edenlabs.sms-sync</string>

  <!-- Every 15 minutes. A bank SMS arrives seconds after the transaction, so
       this is about keeping the dashboard current rather than instant. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/charlesrohan/Projects/EdenLabs Dashboard/eden-labs/scripts/sms-sync.mjs</string>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/edenlabs-sms-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/edenlabs-sms-sync.log</string>
</dict>
</plist>
