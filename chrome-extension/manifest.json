{
  "manifest_version": 3,
  "name": "Eden Labs CRM",
  "version": "1.0.0",
  "description": "Right-click any name on any website to save it as a lead in your Eden Labs CRM.",

  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://dashboard.theedenlabs.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Eden Labs CRM",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "settings/settings.html",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
